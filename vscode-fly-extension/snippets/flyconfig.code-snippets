{
  "Fly Config (Basic)": {
    "prefix": "fly:config",
    "body": [
      "import { defineConfig } from \"fly-framework/src/core/config\";",
      "",
      "export default defineConfig({",
      "  appDir: \"${1:./app}\",",
      "  siteUrl: \"${2:https://mysite.com}\",",
      "  adapter: \"${3|node,edge,serverless}\",",
      "  build: {",
      "    minify: ${4:true},",
      "    sourcemap: ${5:false}",
      "  }",
      "});"
    ],
    "description": "Create a fly.config.ts configuration file"
  },
