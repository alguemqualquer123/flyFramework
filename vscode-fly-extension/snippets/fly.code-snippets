  "Fly Middleware (Auth)": {
    "prefix": "fly:middleware-auth",
    "body": [
      "<script>",
      "  export default async function middleware({ request, next }) {",
      "    const url = new URL(request.url);",
      "    const session = request.headers.get(\"cookie\");",
      "",
      "    if (url.pathname.startsWith(\"/dashboard\") && !session) {",
      "      return Response.redirect(\"/login\", 302);",
      "    }",
      "",
      "    return next();",
      "  }",
      "</script>"
    ],
    "description": "Create a Fly middleware with auth check"
  },
