  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "comment.block", "comment.line", "comment.block.documentation"],
      "settings": {
        "foreground": "#8B949E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted"],
      "settings": {
        "foreground": "#A5D6FF"
      }
    },
    {
      "name": "Template Strings",
      "scope": ["string.template", "string.quoted.template"],
      "settings": {
        "foreground": "#A5D6FF"
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float"],
      "settings": {
        "foreground": "#79C0FF"
      }
    },
    {
      "name": "Boolean",
      "scope": ["constant.language"],
      "settings": {
        "foreground": "#79C0FF"
      }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "keyword.control", "keyword.operator.new", "keyword.operator.expression"],
      "settings": {
        "foreground": "#FF7B72"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#FF7B72"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#D2A8FF"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other"],
      "settings": {
        "foreground": "#C9D1D9"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "variable.other.readwrite"],
      "settings": {
        "foreground": "#FFA657"
      }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "variable.other.object.property"],
      "settings": {
        "foreground": "#C9D1D9"
      }
    },
    {
      "name": "Types / Classes",
      "scope": ["entity.name.type", "entity.other.inherited-class", "support.type"],
      "settings": {
        "foreground": "#7EE787"
      }
    },
    {
      "name": "Interfaces",
      "scope": ["entity.name.type.interface"],
      "settings": {
        "foreground": "#7EE787",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Enums",
      "scope": ["entity.name.type.enum"],
      "settings": {
        "foreground": "#7EE787"
      }
    },
    {
      "name": "Decorators / Annotations",
      "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
      "settings": {
        "foreground": "#D2A8FF"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "keyword.operator.assignment", "keyword.operator.arithmetic", "keyword.operator.comparison", "keyword.operator.logical"],
      "settings": {
        "foreground": "#FF7B72"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "punctuation.definition", "punctuation.separator", "punctuation.terminator"],
      "settings": {
        "foreground": "#C9D1D9"
      }
    },
    {
      "name": "HTML Tags",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#7EE787"
      }
    },
    {
      "name": "HTML Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#79C0FF"
      }
    },
    {
      "name": "CSS Properties",
      "scope": ["support.type.property-name"],
      "settings": {
        "foreground": "#79C0FF"
      }
    },
    {
      "name": "CSS Values",
      "scope": ["support.constant.property-value", "constant.other.color"],
      "settings": {
        "foreground": "#A5D6FF"
      }
    },
    {
      "name": "CSS Units",
      "scope": ["keyword.other.unit"],
      "settings": {
        "foreground": "#79C0FF"
      }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#7EE787"
      }
    },
    {
      "name": "Escape Characters",
      "scope": ["constant.character.escape"],
      "settings": {
        "foreground": "#FFA657"
      }
    },
    {
      "name": "Import/Export Keywords",
      "scope": ["keyword.control.import", "keyword.control.export", "keyword.control.from"],
      "settings": {
        "foreground": "#FF7B72"
      }
    },
    {
      "name": "Async/Await",
      "scope": ["storage.modifier.async", "keyword.control.async", "keyword.control.await"],
      "settings": {
        "foreground": "#FF7B72",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Arrow Functions",
      "scope": ["keyword.operator.arrow", "storage.type.function.arrow"],
      "settings": {
        "foreground": "#FF7B72"
      }
    },

    {
      "name": "Fly: Directive - use server",
      "scope": ["keyword.directive.use-server.fly"],
      "settings": {
        "foreground": "#569CD6",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Fly: Directive - use client",
      "scope": ["keyword.directive.use-client.fly"],
      "settings": {
        "foreground": "#569CD6",
        "fontStyle": "bold italic"
      }
    },
    {
      "name": "Fly: State Declaration",
      "scope": ["keyword.other.state.fly"],
      "settings": {
        "foreground": "#D2A8FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Fly: State Variable",
      "scope": ["variable.other.state.fly"],
      "settings": {
        "foreground": "#FFA657",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Fly: Loader Function",
      "scope": ["support.function.loader.fly"],
      "settings": {
        "foreground": "#7EE787",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Fly: Meta Function",
      "scope": ["support.function.meta.fly"],
      "settings": {
        "foreground": "#7EE787",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Fly: API Handlers (GET/POST/PUT/PATCH/DELETE)",
      "scope": ["support.function.api-handler.fly"],
      "settings": {
        "foreground": "#FFA657",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Fly: Middleware Function",
      "scope": ["support.function.middleware.fly"],
      "settings": {
        "foreground": "#7EE787",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Fly: generateStaticParams",
      "scope": ["support.function.generateStaticParams.fly"],
      "settings": {
        "foreground": "#7EE787",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Fly: Server Action",
      "scope": ["support.function.action.fly"],
      "settings": {
        "foreground": "#D2A8FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Fly: Config Export - render",
      "scope": ["meta.export.render.fly"],
      "settings": {
        "foreground": "#4FC1FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Fly: Config Export - revalidate",
      "scope": ["meta.export.revalidate.fly"],
      "settings": {
        "foreground": "#4FC1FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Fly: Config Export - prerender",
      "scope": ["meta.export.prerender.fly"],
      "settings": {
        "foreground": "#4FC1FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Fly: if Attribute",
      "scope": ["entity.other.attribute-name.fly-if"],
      "settings": {
        "foreground": "#FF7B72",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Fly: for Attribute",
      "scope": ["entity.other.attribute-name.fly-for"],
      "settings": {
        "foreground": "#FF7B72",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Fly: Slot Tag",
      "scope": ["entity.name.tag.slot.fly"],
      "settings": {
        "foreground": "#FFD700",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Fly: Interpolation",
      "scope": ["meta.interpolation.fly", "expression.embedded.fly"],
      "settings": {
        "foreground": "#FFA657"
      }
    },
    {
      "name": "Fly: Directive Interpolation",
      "scope": ["expression.embedded.directive.fly"],
      "settings": {
        "foreground": "#FFA657"
      }
    },
    {
      "name": "Fly: Directive String",
      "scope": ["string.quoted.directive.fly"],
      "settings": {
        "foreground": "#A5D6FF"
      }
    },
    {
      "name": "Fly: Interpolation Punctuation",
      "scope": ["punctuation.definition.interpolation.begin.fly", "punctuation.definition.interpolation.end.fly"],
      "settings": {
        "foreground": "#FFD700"
      }
    },
    {
      "name": "Fly: Config Variables",
      "scope": ["variable.language.config.fly"],
      "settings": {
        "foreground": "#4FC1FF",
        "fontStyle": "bold"
      }
    }
  ]
}
