<script>
  let msg = $state("")
</script>

<h1>Contato (Server Actions)</h1>

<!-- Formulário com progressive enhancement -->
<form data-fly-action="addTodo" method="post">
  <input name="text" placeholder="digite algo" />
  <button type="submit">Enviar (form)</button>
</form>

<!-- Ou chamada programática (sem VDOM) -->
<button on:click={() => window.__flyActions.addTodo("via JS").then(r => msg = "Salvo: " + r.text)}>
  Enviar via JS
</button>

<p>{msg}</p>

<Link href="/">← voltar</Link>
